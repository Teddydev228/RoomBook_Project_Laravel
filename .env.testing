# Configuration pour les tests automatisés

APP_NAME=RoomBook
APP_ENV=testing
APP_KEY=base64:test_key_for_testing_only
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# API Configuration
ROOMBOOK_API_URL=http://localhost:8001
USE_MOCK_DATA=true  # Toujours true pour les tests

# Database (SQLite in-memory pour tests)
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Session
SESSION_DRIVER=array
CACHE_DRIVER=array
QUEUE_CONNECTION=sync

# Mail
MAIL_MAILER=array
